{
	"permissions": {
		"deny": [
			"Read(./.env)",
			"Read(./.env.*)",
			"Read(./secrets/**)",
			"Edit(./.env)",
			"Edit(./secrets/**)"
		]
	},
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Edit|Write",
				"hooks": [
					{
						"type": "command",
						"command": "jq -r '.tool_response.filePath // .tool_input.file_path' | { read -r f; case \"$f\" in *.ts) npx --no-install prettier --write --ignore-unknown \"$f\" ;; esac; } 2>/dev/null || true",
						"timeout": 30,
						"statusMessage": "Formatting with prettier..."
					}
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": "Read|Edit|Write|NotebookEdit|Grep|Glob|Bash",
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-secrets.sh",
						"timeout": 10,
						"statusMessage": "Checking for protected paths..."
					}
				]
			}
		]
	}
}
