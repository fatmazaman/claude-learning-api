		"eslint-config-prettier": "^10.1.8",
		"jest": "^30.5.2",
		"prettier": "^3.9.10",
		"ts-jest": "^29.4.15",
		"tsx": "^4.23.15",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.72.1"
